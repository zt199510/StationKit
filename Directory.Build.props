<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- 中文註釋的庫，不強制要求每個公開成員都寫 XML 文檔 -->
    <NoWarn>$(NoWarn);CS1591;CA1716;CA1031;CA1848;CA1805</NoWarn>
    <Authors>zt199510</Authors>
  </PropertyGroup>
</Project>
